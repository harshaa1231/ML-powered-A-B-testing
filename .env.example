# Copy to .env and fill in real values before running docker-compose.

# --- Backend ---
DATABASE_URL=postgresql+asyncpg://abtesting:abtesting@postgres:5432/abtesting
DATABASE_URL_SYNC=postgresql+psycopg2://abtesting:abtesting@postgres:5432/abtesting
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Groq: free API key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

STORAGE_DIR=/app/storage

# --- Postgres (docker-compose) ---
POSTGRES_USER=abtesting
POSTGRES_PASSWORD=abtesting
POSTGRES_DB=abtesting

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
